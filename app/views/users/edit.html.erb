<h2>プロフィール編集</h2>

<%= form_with model: @user do |f| %>
  <div>
    <%= f.label :name, "Name" %>
    <%= f.text_field :name,
                     autofocus: true,
                     id: "inputName",
                     placeholder: "名前" %>
  </div>

  <div>
    <%= f.label :profile_image, "ProfileImage" %>
    <%= f.file_field :profile_image,
                     id: "inputImage",
                     accept: "image/*" %>
  </div>

  <%= f.submit "変更を保存" %>
<% end %>